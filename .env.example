# Campus Connect - example environment file (BACKEND).
# Copy to ".env" for local development (python-dotenv loads it; real environment variables always win) or
# enter these in the Render dashboard for production. ".env" is git-ignored. NEVER commit real values.
# Every variable below is read by api/settings.py (Settings.from_env), app.py or create_admin.py.
# The Vercel frontend needs NO environment variables (vercel.json rewrites /api, /uploads, /healthz to Render).

# --- Core ---------------------------------------------------------------------------------
# "production" = Secure cookies, HSTS, SECRET_KEY validation, /docs disabled. "development" locally.
# (If unset, Render's own RENDER variable implies production.)
APP_ENV=development
# Long random string. REQUIRED in production (Render: generateValue; at least 24 characters).
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# "1" enables auto-reload for `python app.py` and the /docs pages. Ignored when APP_ENV=production.
DEBUG=0
# Bind address / port for `python app.py` (Render injects PORT for the uvicorn start command).
HOST=127.0.0.1
PORT=5000

# --- Database: Neon PostgreSQL -------------------------------------------------------------
# DIRECT connection string (host WITHOUT "-pooler"): used for schema migrations and maintenance scripts.
# POOLED connection string (host WITH "-pooler", PgBouncer): used for all normal application traffic.
# Both must contain ?sslmode=require (TLS). Local development can point both at a local PostgreSQL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL_POOLED=postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=require
# Max pooled connections per process (Render Free is 512 MB). Default 10.
# DB_POOL_MAX=10
# Built SPA served by the API when present (single-origin local runs). Default: ./frontend/dist
# FRONTEND_DIST=

# --- Reverse proxy (Vercel rewrite -> Render) ----------------------------------------------
# Honour X-Forwarded-* (client IP for rate limiting, https scheme). Hops = proxies in front of the app:
# Vercel rewrite + Render's load balancer = 2. Use 1 if a custom domain points straight at Render.
TRUST_PROXY=0
TRUST_PROXY_HOPS=1

# --- Primary administrator -----------------------------------------------------------------
# The owner account: always an active admin, cannot be deactivated, only it may invite other admins.
PRIMARY_ADMIN_EMAIL=mkkarthik0609@gmail.com
# First-admin bootstrap (idempotent: creates the account only when it does not exist; NEVER overwrites a
# password; ADMIN_PASSWORD is removed from the process environment after use). ADMIN_EMAIL must equal
# PRIMARY_ADMIN_EMAIL. Set these ONLY in the host's secret store; remove ADMIN_PASSWORD afterwards.
BOOTSTRAP_ADMIN=0
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Admin invitations / e-mail ------------------------------------------------------------
# Public origin of the SPA: invitation links are PUBLIC_APP_URL/admin-invite#t=<token>.
PUBLIC_APP_URL=http://localhost:5173
INVITE_TTL_HOURS=72
# Resend (https://resend.com, free: 100 mails/day). Without both values NO mail is sent: the API reports
# email_delivery=NOT_CONFIGURED and shows the one-time link to the primary admin instead.
RESEND_API_KEY=
MAIL_FROM=Campus Connect <no-reply@your-verified-domain.example>

# --- Misc ----------------------------------------------------------------------------------
# Meeting-reminder interval (minutes) and scheduler switch (reminders are claimed atomically in SQL).
REMINDER_INTERVAL_MINUTES=60
ENABLE_SCHEDULER=1
# Seed ECE/ISE/EEE/Mechanical/Civil next to the CSE defaults at first start (0 turns it off).
SEED_EXTRA_BRANCHES=1
# Auth throttling (defaults shown). The per-IP limit is deliberately high: a whole campus can share one address.
# LOGIN_MAX_FAILURES_PER_IDENTIFIER=5
# LOGIN_MAX_FAILURES_PER_IP=150
# LOGIN_CAPTCHA_AFTER_FAILURES=3
# SESSION_IDLE_TIMEOUT_MINUTES=60

# --- Tests ----------------------------------------------------------------------------------
# A THROW-AWAY PostgreSQL superuser connection used by `pytest` (it creates/drops cc_test_* databases).
# NEVER point this at Neon production.
# TEST_DATABASE_ADMIN_URL=postgresql://postgres@127.0.0.1:54329/postgres
