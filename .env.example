# Campus Connect - example environment file.
# Copy to ".env" for local development (python-dotenv loads it) or enter these in the Render
# dashboard for production. ".env" is git-ignored. NEVER commit real values.

# --- Core ---------------------------------------------------------------------------------
# "production" => Secure cookies, HSTS, mandatory strong SECRET_KEY. Use "development" locally.
APP_ENV=development
# Long random string. REQUIRED in production (Render: generateValue). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
# "1" enables the Flask debugger for `python app.py`. Never in production.
FLASK_DEBUG=0
# Bind address / port for `python app.py` (Render injects PORT for gunicorn).
HOST=127.0.0.1
PORT=5000

# --- Storage ------------------------------------------------------------------------------
# Defaults: ./database.db and ./uploads. On Render use the persistent disk mounted at /var/data.
DATABASE_PATH=./database.db
UPLOAD_ROOT=./uploads
# DATABASE_PATH=/var/data/campusconnect.db
# UPLOAD_ROOT=/var/data/uploads

# --- Reverse proxy (Vercel rewrite -> Render) ----------------------------------------------
# "1" makes the app honour X-Forwarded-* headers. Leave 0 for local development.
TRUST_PROXY=0
# Proxies appending to X-Forwarded-For: Vercel + Render = 2 (Render only = 1).
TRUST_PROXY_HOPS=1
# Strict HTTPS Referer check in Flask-WTF. Defaults to OFF when TRUST_PROXY=1 (see DEPLOYMENT.md).
# CSRF_SSL_STRICT=1

# --- First admin bootstrap ----------------------------------------------------------------
# With BOOTSTRAP_ADMIN=1 the app creates this admin at start-up if none exists (idempotent).
# `python create_admin.py --from-env` reads the same three variables.
BOOTSTRAP_ADMIN=0
ADMIN_NAME=Your Name
ADMIN_EMAIL=admin@example.edu
ADMIN_PASSWORD=choose-a-strong-password-here

# --- Student signup OTP -------------------------------------------------------------------
# "1" shows the OTP on screen (demo mode, used when SMTP is not configured). Set 0 with SMTP.
SHOW_DEMO_OTP=1
# Optional SMTP delivery of the OTP (leave SMTP_HOST empty to disable e-mail).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# "1"/"starttls", "ssl" or "0"
SMTP_TLS=1

# --- Background jobs / tuning (all optional) -----------------------------------------------
REMINDER_INTERVAL_MINUTES=60
# "0" disables the in-process meeting-reminder scheduler.
ENABLE_SCHEDULER=1
LOGIN_MAX_FAILURES_PER_IDENTIFIER=5
LOGIN_MAX_FAILURES_PER_IP=20
SESSION_IDLE_TIMEOUT_MINUTES=60
OTP_MAX_PER_EMAIL_PER_HOUR=5
OTP_MAX_PER_IP_PER_HOUR=20

# --- gunicorn (read by gunicorn.conf.py; Render sets PORT itself) ---------------------------
# GUNICORN_THREADS=4
# LOG_LEVEL=info
# --- Backups (scripts/backup_db.py) ---------------------------------------------------------
# BACKUP_DIR=./backups

# --- Set by the platform / framework, not by you ----------------------------------------------
# FLASK_ENV   legacy alias for APP_ENV (APP_ENV wins).
# RENDER      Render sets RENDER=true; the app then defaults to production mode.
# WERKZEUG_RUN_MAIN  set by the Flask reloader; used to start the scheduler only once in debug.
