# Campus Connect - example environment file (BACKEND).
# Copy to ".env" for local development (python-dotenv loads it; real environment variables win) or
# enter these in the Render dashboard for production. ".env" is git-ignored. NEVER commit real values.
# Every variable below is read by api/settings.py (Settings.from_env), app.py or create_admin.py.

# --- Core ---------------------------------------------------------------------------------
# "production" => Secure session cookie, HSTS, mandatory strong SECRET_KEY, /docs disabled.
# Use "development" locally. (If unset, Render's own RENDER variable implies production.)
APP_ENV=development
# Long random string. REQUIRED in production (Render: generateValue; at least 24 characters).
# In development a random key is generated into .dev_secret_key when this is empty. Generate one:
#   venv\Scripts\python.exe -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# "1" enables auto-reload for `python app.py` and the /docs, /redoc, /openapi.json pages.
# Ignored when APP_ENV=production.
DEBUG=0
# Bind address / port for `python app.py` (Render injects PORT for the uvicorn start command).
HOST=127.0.0.1
PORT=5000

# --- Storage ------------------------------------------------------------------------------
# Defaults: ./database.db and ./uploads. On Render use the persistent disk mounted at /var/data.
DATABASE_PATH=./database.db
UPLOAD_ROOT=./uploads
# DATABASE_PATH=/var/data/campusconnect.db
# UPLOAD_ROOT=/var/data/uploads
# Built SPA served by the API when present (single-origin local runs). Default: ./frontend/dist
# FRONTEND_DIST=./frontend/dist

# --- Reverse proxy (Vercel rewrite -> Render) ----------------------------------------------
# "1" makes the app honour X-Forwarded-* headers (client IP, https scheme). Leave 0 locally.
TRUST_PROXY=0
# Proxies appending to X-Forwarded-For: Vercel + Render = 2 (Render only = 1).
TRUST_PROXY_HOPS=1

# --- First admin bootstrap ----------------------------------------------------------------
# With BOOTSTRAP_ADMIN=1 the app creates this admin at start-up if the account does not exist
# (idempotent; never overwrites an existing password). `python create_admin.py --from-env` reads
# the same three variables. Password: 8+ characters with upper-case, lower-case and a digit.
BOOTSTRAP_ADMIN=0
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Captcha (student/faculty signup; login after repeated failures) ------------------------
# No e-mail / OTP: signup is email + password + an image captcha (letters and digits, single use).
CAPTCHA_MAX_PER_IP_PER_HOUR=60
# Login asks for a captcha after this many recent failed attempts for the same identifier.
LOGIN_CAPTCHA_AFTER_FAILURES=3

# --- Background jobs / tuning (all optional) -----------------------------------------------
REMINDER_INTERVAL_MINUTES=60
# "0" disables the in-process meeting-reminder scheduler.
ENABLE_SCHEDULER=1
LOGIN_MAX_FAILURES_PER_IDENTIFIER=5
LOGIN_MAX_FAILURES_PER_IP=20
SESSION_IDLE_TIMEOUT_MINUTES=60

# --- Backups (scripts/backup_db.py) ---------------------------------------------------------
# BACKUP_DIR=./backups

# --- Set by the platform, not by you ----------------------------------------------------------
# RENDER   Render sets RENDER=true; the app then defaults to production mode.

# ==========================================================================================
# FRONTEND (frontend/) - not read from this file; set in the shell or in the Vercel project.
# ==========================================================================================
# BACKEND_URL       Vercel build: origin of the Render service (https://<service>.onrender.com).
#                   frontend/scripts/set-backend-url.mjs writes it into frontend/vercel.json rewrites.
# VITE_BACKEND_URL  Local dev only: target of the Vite proxy for /api, /uploads, /healthz
#                   (default http://127.0.0.1:5000).
